@@ -9049,3 +9046,70 @@ fn base64_encode(data: &[u8]) -> String {
 
 #[cfg(test)]
 mod tests;
+
+/// 문단 목록과 그 안의 개체가 담은 모든 문단(표 셀·캡션·글상자·묶음 개체·머리말/꼬리말·
+/// 각주/미주·숨은 설명·필드 메모·바탕쪽)을 차례로 방문한다.
+fn for_each_paragraph_mut(paragraphs: &mut [Paragraph], f: &mut dyn FnMut(&mut Paragraph)) {
+    fn caption(c: &mut Option<crate::model::shape::Caption>, f: &mut dyn FnMut(&mut Paragraph)) {
+        if let Some(c) = c.as_mut() {
+            for_each_paragraph_mut(&mut c.paragraphs, f);
+        }
+    }
+    fn drawing(d: &mut crate::model::shape::DrawingObjAttr, f: &mut dyn FnMut(&mut Paragraph)) {
+        if let Some(text_box) = d.text_box.as_mut() {
+            for_each_paragraph_mut(&mut text_box.paragraphs, f);
+        }
+        caption(&mut d.caption, f);
+    }
+    fn shape(s: &mut ShapeObject, f: &mut dyn FnMut(&mut Paragraph)) {
+        match s {
+            ShapeObject::Picture(pic) => caption(&mut pic.caption, f),
+            ShapeObject::Group(group) => {
+                for child in &mut group.children {
+                    shape(child, f);
+                }
+                caption(&mut group.caption, f);
+            }
+            ShapeObject::Chart(chart) => {
+                drawing(&mut chart.drawing, f);
+                caption(&mut chart.caption, f);
+            }
+            ShapeObject::Ole(ole) => {
+                drawing(&mut ole.drawing, f);
+                caption(&mut ole.caption, f);
+            }
+            _ => {
+                if let Some(d) = s.drawing_mut() {
+                    drawing(d, f);
+                }
+            }
+        }
+    }
+    for para in paragraphs {
+        f(para);
+        for control in &mut para.controls {
+            match control {
+                Control::Table(table) => {
+                    for cell in &mut table.cells {
+                        for_each_paragraph_mut(&mut cell.paragraphs, f);
+                    }
+                    caption(&mut table.caption, f);
+                }
+                Control::Picture(pic) => caption(&mut pic.caption, f),
+                Control::Shape(s) => shape(s, f),
+                Control::Header(h) => for_each_paragraph_mut(&mut h.paragraphs, f),
+                Control::Footer(h) => for_each_paragraph_mut(&mut h.paragraphs, f),
+                Control::Footnote(n) => for_each_paragraph_mut(&mut n.paragraphs, f),
+                Control::Endnote(n) => for_each_paragraph_mut(&mut n.paragraphs, f),
+                Control::HiddenComment(c) => for_each_paragraph_mut(&mut c.paragraphs, f),
+                Control::Field(field) => for_each_paragraph_mut(&mut field.memo_paragraphs, f),
+                Control::SectionDef(section_def) => {
+                    for master_page in &mut section_def.master_pages {
+                        for_each_paragraph_mut(&mut master_page.paragraphs, f);
+                    }
+                }
+                _ => {}
+            }
+        }
+    }
+}
